<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Number of cards parsed in parallel. Large scene cards make higher values counterproductive. -->
    <add key="MaxDegreeOfParallelism" value="2" />
  </appSettings>
  <runtime>
    <!-- Disables the .NET 4.7.2+ DataGridView FullRowSelect header highlight accessibility feature. -->
    <AppContextSwitchOverrides value="Switch.UseLegacyAccessibilityFeatures=true;Switch.UseLegacyAccessibilityFeatures.2=true;Switch.UseLegacyAccessibilityFeatures.3=true" />
  </runtime>
</configuration>
